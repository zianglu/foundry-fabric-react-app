# App and tenant
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
BACKEND_CLIENT_ID=00000000-0000-0000-0000-000000000000
BACKEND_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
BACKEND_REQUIRED_SCOPE=access_as_user

# Use certificate auth in Azure (recommended)
BACKEND_CLIENT_CERTIFICATE_PATH=/mnt/secrets/backend-obo-pem
BACKEND_CLIENT_CERTIFICATE_THUMBPRINT=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Local development fallback only
# BACKEND_CLIENT_SECRET=

# Foundry Agent endpoint (replace with your Agent runtime endpoint)
# You can include {agent_id} in the URL, e.g.:
# https://<project>.services.ai.azure.com/api/projects/<project-id>/agents/{agent_id}/chat/completions?api-version=2025-05-15-preview
FOUNDRY_AGENT_ENDPOINT=https://your-project.services.ai.azure.com/path/to/agent/endpoint
FOUNDRY_AGENT_SCOPE=https://ai.azure.com/.default
FOUNDRY_AGENT_ID=00000000-0000-0000-0000-000000000000

# Fabric Graph API config
FABRIC_GRAPH_BASE_URL=https://api.fabric.microsoft.com/v1/workspaces/<workspace-id>/graph
FABRIC_GRAPHQL_URL=https://api.fabric.microsoft.com/v1/workspaces/<workspace-id>/GraphModels/<model-id>/executeQuery?beta=true
FABRIC_GRAPH_SCOPE=https://api.fabric.microsoft.com/.default
FABRIC_GRAPH_TRUCKS_PATH=/trucks
FABRIC_GRAPH_DRIVERS_PATH=/drivers
FABRIC_GRAPH_LOADS_PATH=/loads
FABRIC_GRAPH_TRIPS_PATH=/trips
FABRIC_GRAPH_CUSTOMERS_PATH=/customers

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
HTTP_TIMEOUT_SECONDS=30
